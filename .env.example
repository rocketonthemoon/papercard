# Copy to .env and fill in.

# OAuth 2.0 Client ID (type "Web application") from https://console.cloud.google.com/apis/credentials
# Add your site's address (e.g. http://localhost:8080) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# 1 = also show a "Play as guest" name box (handy for local testing; anyone can pick any name).
ALLOW_DEV_LOGIN=0

# Who can open the content editor (#/admin): comma-separated Google emails.
# Guest logins count as dev:<name>, e.g. ADMINS=you@gmail.com,dev:alice
ADMINS=

# 1 when the site is served over HTTPS.
COOKIE_SECURE=0

# Port on your machine.
PORT=8080

# ---- Production with HTTPS (podman compose --profile https up -d --build)
# Your domain, pointing at this server. Caddy gets a free certificate for it.
# DOMAIN=labas.example.com
# Only accept app traffic through Caddy:
# BIND=127.0.0.1
# Also set COOKIE_SECURE=1 and ALLOW_DEV_LOGIN=0, and add https://<DOMAIN> to the
# OAuth client's "Authorized JavaScript origins" in Google Cloud Console.
