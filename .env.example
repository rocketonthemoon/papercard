# Copy to .env and fill in.

# OAuth 2.0 Client ID (type "Web application") from https://console.cloud.google.com/apis/credentials
# Add your site's address (e.g. https://vokab.example.com) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# 1 = also show a "Play as guest" name box (handy for local testing; anyone can pick any name).
ALLOW_DEV_LOGIN=0

# Who can open the content editor (#/admin): comma-separated Google emails.
# Guest logins count as dev:<name>, e.g. ADMINS=you@gmail.com,dev:alice
ADMINS=

# 1 when the site is served over HTTPS (Traefik in Dokploy terminates SSL).
COOKIE_SECURE=1

# Port for direct access or local testing.
PORT=8080

# Domain for Dokploy / Traefik routing.
DOMAIN=vokab.example.com

# Official system account name.
OFFICIAL_NAME=Vokab
